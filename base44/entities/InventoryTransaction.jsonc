{
  "name": "InventoryTransaction",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "purchase",
        "reservation",
        "release",
        "sale",
        "return",
        "damage",
        "adjustment"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "reference_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}